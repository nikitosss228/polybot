# =============================================================================
# Polybot — Polymarket edge-detection / backtest harness
# Copy this file to `.env` and fill in. NEVER commit `.env`.
# Use `chmod 600 .env` to restrict access.
# =============================================================================

# --- Run mode ----------------------------------------------------------------
# DRY_RUN=1 logs intended orders only, never submits to the exchange.
# Strongly recommended to start with 1 and review logs/candidates.csv first.
DRY_RUN=1

# AUTO_TRADE=1 lets the bot place orders automatically when DRY_RUN=0.
# Default 0 = surface candidates only, no execution.
AUTO_TRADE=0

# Paper-trading mode: simulates fills against a virtual wallet and writes to
# logs/sim_wallet.json. Use this to validate sizing/risk logic with real
# market data, without risking actual USDC.
SIMULATION_MODE=0
SIMULATION_STARTING_USDC=100

# --- Wallet / auth (Polygon mainnet) -----------------------------------------
# Polymarket has no testnet. Live trading needs a Polygon EOA with USDC and
# a small amount of MATIC for gas. WARNING: PRIVATE_KEY controls real funds.
# Use a dedicated wallet funded only with the bot budget.
PRIVATE_KEY=

# 0 = EOA (recommended for self-funded bots)
# 1 = Polymarket proxy wallet (set FUNDER_ADDRESS to the proxy)
# 2 = Gnosis Safe
SIGNATURE_TYPE=0
FUNDER_ADDRESS=

# Polygon RPC (read-only health checks). Blank = public RPC.
POLYGON_RPC_URL=

# Optional SOCKS5 proxy for users in regions where Polymarket is geoblocked.
# Format: socks5://user:pass@host:port  (or socks5h:// for DNS via proxy)
# Leave blank to use direct connection.
SOCKS5_PROXY=

# --- Risk caps (USDC) --------------------------------------------------------
TOTAL_BUDGET=100
MAX_PER_TRADE=5
MAX_TOTAL_EXPOSURE=80
MAX_DAILY_LOSS=10

# Lifetime drawdown kill-switch as % of TOTAL_BUDGET. When cumulative PnL
# drops this far below its peak, no new trades open until restart.
MAX_DRAWDOWN_PCT=25

# --- Edge gates --------------------------------------------------------------
# MIN_EDGE_PCT is gross (pre-fee). MIN_EDGE_AFTER_FEES_PCT is net of estimated
# gas; bundle arbitrage and MM detectors enforce the after-fees floor.
MIN_EDGE_PCT=1.5
MIN_EDGE_AFTER_FEES_PCT=0.5
GAS_ESTIMATE_PER_ORDER=0.001

# --- Market filters ----------------------------------------------------------
MIN_24H_VOLUME=1000
MAX_PRICE=0.99
MIN_PRICE=0.01

# --- Detector C: Bundle arbitrage --------------------------------------------
# Binary markets where ask_yes + ask_no < 1 are risk-free at resolution.
BUNDLE_ARB_ENABLED=1
BUNDLE_ARB_MIN_EDGE_PCT=1.0

# --- Detector D: Market-making spread flagger --------------------------------
# Surfaces (does NOT auto-trade) liquid markets with wide bid-ask spreads.
MM_FLAGGER_ENABLED=1
MM_MIN_SPREAD=0.05
MM_MIN_VOLUME=5000

# --- Position sizing ---------------------------------------------------------
# Mode: flat | per_detector | edge_scaled | fractional_kelly
#
#   flat            — every trade = MAX_PER_TRADE
#   per_detector    — fixed size per detector (SIZE_* below)
#   edge_scaled     — size proportional to edge_pct / EDGE_SCALE_REF
#   fractional_kelly — f = p − (1−p)·P/(1−P), capped at 0.5×KELLY_FRACTION
#                     of TOTAL_BUDGET. Uses WINRATE_* priors below.
SIZING_MODE=flat
EDGE_SCALE_REF=10.0
KELLY_FRACTION=0.125

# Per-detector flat sizes (used when SIZING_MODE=per_detector or as fallback).
SIZE_DATE_EXPIRED=3.00
SIZE_EXTREME_PRICED=5.00
SIZE_MM_SPREAD=2.50
SIZE_BUNDLE_ARB=5.00

# Per-detector empirical win rates (used by fractional_kelly mode).
# Replace with your own backtest priors. Defaults below were measured by the
# project author on ~2 months of paper-trading data — they may not hold for
# you, on different time windows, or after Polymarket fee/structure changes.
WINRATE_DATE_EXPIRED=0.80
WINRATE_EXTREME_PRICED=0.986
WINRATE_MM_SPREAD=0.50
WINRATE_BUNDLE_ARB=0.50

# --- Scheduler ---------------------------------------------------------------
# How often the scanner runs (seconds). 600 = 10 minutes is gentle on the API.
SCAN_INTERVAL_SEC=600

# Optional category filter (comma-separated tag names from Polymarket).
# Empty = all categories. Examples: politics,sports,crypto
CATEGORY_FILTER=

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=logs/polybot.log
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5
