[Unit]
Description=Polybot — strategy analysis (paper PnL over study CSVs)
Documentation=file:///root/polybot
After=polybot.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/root/polybot
ExecStart=/root/polybot/venv/bin/python /root/polybot/scripts/analyze.py

NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/root/polybot/logs
PrivateTmp=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=polybot-analyze
